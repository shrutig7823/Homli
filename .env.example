# Copy this file to ".env" in the project root and fill it in. NEVER commit .env to GitHub.

# Leave empty on your laptop (the server then uses the local file server/homli.db).
# When deployed, paste your hosted Postgres address here (from Neon or Supabase).
DATABASE_URL=

# Which websites may call the API. Comma separated.
ALLOWED_ORIGINS=http://localhost:8123,https://shrutig7823.github.io

# Optional: Google Places key, for photos and reviews. Without it the site shows "Photos coming soon".
GOOGLE_MAPS_API_KEY=
